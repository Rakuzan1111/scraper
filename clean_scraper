import pandas as pd

df = pd.read_csv("listings.csv", encoding="utf-8-sig")

# convert n/a to string
for column in df.columns:
    df[column] = df[column].fillna("N/A").astype(str)
    
#remove duplicate websites
df = df.drop_duplicates(subset="Website")

# Make numeric temporary columns for correct numerical sorting
df["price_sort"] = pd.to_numeric(df["Price ($)"].str.replace(r"[^\d.]", "", regex=True),
    errors="coerce")

df["bedrooms_sort"] = pd.to_numeric(df["Bedrooms"].str.extract(r"(\d+)")[0],
    errors="coerce")


df["bathrooms_sort"] = pd.to_numeric(df["Bathrooms"].str.extract(r"(\d+)")[0],
    errors="coerce")

df['parking_sort'] = pd.to_numeric(df['Parking'].str.extract(r'(\d+)')[0],
    errors='coerce')

df["size_sort"] = pd.to_numeric(df["Size (sqft)"].str.extract(r"(\d+)")[0],
    errors="coerce")

# make list to reomve temporary columns
clean_columns=["price_sort","bedrooms_sort","bathrooms_sort","size_sort",'parking_sort']
    
#prices croissant
df.sort_values('price_sort', na_position='last').drop(columns=clean_columns).to_csv(
'price.csv', index=False, encoding='utf-8-sig')

#location alphabetically
df.sort_values('Location', na_position='last').drop(columns=clean_columns).to_csv(
'location.csv', index=False, encoding='utf-8-sig')

#bedrooms croissant
df.sort_values('bedrooms_sort', na_position='last').drop(columns=clean_columns)
'bedrooms.csv', index=False, encoding='utf-8-sig')

#bahtrooms croissant
df.sort_values('bathrooms_sort', na_position='last').drop(columns=clean_columns).to_csv(
'bathrooms.csv', index=False, encoding='utf-8-sig')

#unit type croissant
df.sort_values('Unit Type', na_position='last').drop(columns=clean_columns).to_csv(
'unit_type.csv', index=False, encoding='utf-8-sig')

#parking croissant
df.sort_values('parking_sort', na_position='last').drop(columns=clean_columns).to_csv(
'parking.csv', index=False, encoding='utf-8-sig')

#size croissant
df.sort_values('size_sort', na_position='last').drop(columns=clean_columns).to_csv(
'size.csv', index=False, encoding='utf-8-sig')
